local function round(inst, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = inst
end

local function outline(inst, col, trans)
    local s = Instance.new("UIStroke")
    s.Color = col
    s.Thickness = 1.2
    s.Transparency = trans or 0
    s.Parent = inst
    return s
end

