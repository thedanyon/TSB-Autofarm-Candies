local function setSpeed(val)
    moveSpeed = math.clamp(math.floor(val), minSpeed, maxSpeed)
    speedReadout.Text = "Speed: " .. moveSpeed
    local ratio = (moveSpeed - minSpeed) / (maxSpeed - minSpeed)
    speedFill.Size = UDim2.new(ratio, 0, 1, 0)
end

decBtn.MouseButton1Click:Connect(function()
    setSpeed(moveSpeed - 10)
end)

incBtn.MouseButton1Click:Connect(function()
    setSpeed(moveSpeed + 10)
end)

do
    local sliding = false
    local function updateFromInput(input)
        local relX = math.clamp((input.Position.X - speedBar.AbsolutePosition.X) / speedBar.AbsoluteSize.X, 0, 1)
        setSpeed(minSpeed + relX * (maxSpeed - minSpeed))
    end

    speedReadout.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            updateFromInput(input)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    sliding = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)
end

local function markTarget(part)
    if not part:FindFirstChild("TargetESP") then
        local hl = Instance.new("Highlight")
        hl.Name = "TargetESP"
        hl.FillColor = palette.accent
        hl.FillTransparency = 0.45
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.Adornee = part
        hl.Parent = part
    end
end

local function removeMarks()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Highlight") and v.Name == "TargetESP" then
            v:Destroy()
        end
    end
end

local function glideTo(goalCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not hum then return end

    local dist = (hrp.Position - goalCFrame.Position).Magnitude
    local tween = TweenService:Create(hrp, TweenInfo.new(dist / moveSpeed, Enum.EasingStyle.Linear), {CFrame = goalCFrame})

    local lockConn = RunService.Heartbeat:Connect(function()
        if char and hrp and hum then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            hum.PlatformStand = false
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.Physics then
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
    end)

    tween:Play()
    tween.Completed:Wait()

    if lockConn then
        lockConn:Disconnect()
    end
end

local function locateDoor()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local bestPart, bestPrompt
    local farMode = moveSpeed >= 60
    local bestDist = farMode and -math.huge or math.huge

    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("ProximityPrompt") and item.Parent then
            local valid = item.ObjectText:lower():match("trick")
                or item.ActionText:lower():match("treat")
                or item.Parent.Name:lower():match("halloween")

            if valid and not visited[item.Parent] then
                local part = item.Parent:IsA("BasePart") and item.Parent or item.Parent:FindFirstChildWhichIsA("BasePart")
                if part then
                    local d = (hrp.Position - part.Position).Magnitude
                    if (farMode and d > bestDist) or (not farMode and d < bestDist) then
                        bestDist = d
                        bestPart = part
                        bestPrompt = item
                    end
                end
            end
        end
    end

    return bestPart, bestPrompt
end

local function beginLoop()
    if runnerThread then task.cancel(runnerThread) end
    runnerThread = task.spawn(function()
        stateLabel.Text = "Scanning..."
        stateLabel.TextColor3 = palette.on

        while active do
            task.wait(0.05)
            local part, prompt = locateDoor()

            if part and prompt then
                markTarget(part)
                stateLabel.Text = "Moving: " .. part.Name
                glideTo(part.CFrame * CFrame.new(0, 0, interactOffset))

                stateLabel.Text = "At door..."
                task.wait(doorDelay)

                if fireproximityprompt then
                    fireproximityprompt(prompt)
                else
                    prompt:InputHoldBegin()
                    task.wait(prompt.HoldDuration + 0.05)
                    prompt:InputHoldEnd()
                end

                visited[part] = true
                stateLabel.Text = "Waiting..."
                task.wait(cycleDelay)
            else
                stateLabel.Text = "No doors available"
            end
        end

        stateLabel.Text = "Idle"
        stateLabel.TextColor3 = palette.subtext
    end)
end

local function haltLoop()
    active = false
    if runnerThread then
        task.cancel(runnerThread)
        runnerThread = nil
    end
    removeMarks()
    stateLabel.Text = "Idle"
    stateLabel.TextColor3 = palette.subtext
end

toggleBtn.MouseButton1Click:Connect(function()
    active = not active
    toggleBtn.Text = active and "Running" or "Disabled"
    toggleStroke.Color = active and palette.on or palette.off

    if active then
        visited = {}
        beginLoop()
    else
        haltLoop()
    end
end)

